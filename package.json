{
  "name": "@myship/cli",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "description": "Self-hosted BYOC full-stack & CAS deployment engine (Vercel + surge.sh on your own Tencent Cloud EdgeOne, COS & SCF)",
  "keywords": [
    "deployment",
    "cli",
    "edgeone",
    "tencent-cloud",
    "cos",
    "cas",
    "vercel",
    "surge",
    "static-site",
    "serverless",
    "byoc"
  ],
  "homepage": "https://myship.ship.onehub.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huxy2023/myship.git"
  },
  "bugs": {
    "url": "https://github.com/huxy2023/myship/issues"
  },
  "bin": {
    "myship": "packages/cli/myship.mjs"
  },
  "files": [
    "packages/cli/*.mjs",
    "packages/edge-gateway/edgeone-function.template.js",
    "packages/edge-gateway/edgeone-api-worker.template.js",
    "packages/edge-gateway/local-gateway.mjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --test packages/cli/test/*.test.mjs",
    "demo": "pnpm --filter @myship/cas-sandbox test:local",
    "demo:cloud": "pnpm --filter @myship/cas-sandbox demo:cloud",
    "build:site": "pnpm --filter @myship/site build",
    "ship": "node packages/cli/myship.mjs",
    "ship:ls": "node packages/cli/myship.mjs ls",
    "ship:all": "node packages/cli/myship.mjs ls --all",
    "ship:rollback": "node packages/cli/myship.mjs rollback",
    "ship:site": "pnpm --filter @myship/site ship",
    "gateway:local": "pnpm --filter @myship/edge-gateway dev"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1"
  }
}
